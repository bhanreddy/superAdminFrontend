{
  "name": "nexsyrus-superadmin",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "deploy": "npm run build:web && npx wrangler deploy",
    "preview:cloudflare": "npm run build:web && npx wrangler dev",
    "postinstall": "patch-package && node scripts/cloudflare-postinstall.cjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --test tests/*.test.cjs",
    "test:checklist": "node --test tests/checklist.test.cjs",
    "test:sales-command": "node test/sales-command.contract.test.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-picker/picker": "^2.11.4",
    "@supabase/supabase-js": "^2.39.3",
    "axios": "^1.6.5",
    "expo": "~50.0.14",
    "expo-blur": "~12.9.2",
    "expo-build-properties": "~0.11.1",
    "expo-clipboard": "~5.0.1",
    "expo-constants": "~15.4.5",
    "expo-document-picker": "~11.10.1",
    "expo-file-system": "~16.0.9",
    "expo-linear-gradient": "~12.7.2",
    "expo-linking": "~6.2.2",
    "expo-router": "~3.4.8",
    "expo-secure-store": "~12.8.1",
    "expo-sharing": "~11.10.0",
    "expo-status-bar": "~1.11.1",
    "lucide-react-native": "^0.363.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-native-url-polyfill": "1.3.0",
    "react-native-web": "~0.19.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "expo-module-scripts": "^3.0.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.1.3"
  },
  "private": true
}
