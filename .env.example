EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── SuperAdmin Backend (PORT 4000) — all super-admin + medical routes ──
# Android emulator → host: http://10.0.2.2:4000  |  iOS simulator: http://127.0.0.1:4000
# Physical device on same WiFi: http://<your-lan-ip>:4000
EXPO_PUBLIC_SUPERADMIN_API_URL=
# Expo web (Chrome on your PC): e.g. http://127.0.0.1:4000
EXPO_PUBLIC_SUPERADMIN_API_URL_WEB=

# ── School / SupabaseBackend (only needed if you still call school-only routes) ──
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_URL_WEB=

